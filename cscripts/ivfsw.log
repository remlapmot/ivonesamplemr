. // simulate data
. clear

. set obs 4000
Number of observations (_N) was 0, now 4,000.

. set seed 12345

. gen z1 = rnormal()

. gen z2 = rnormal()

. gen w1 = rnormal()

. gen w2 = rnormal()

. gen u = rnormal()

. gen x1 = z1 + z2 + 0.2*u + 0.1*w1 + rnormal()

. gen x2 = z1 + 0.94*z2 - 0.3*u + 0.1*w2 + rnormal()

. gen y = x1 + x2 + w1 + w2 + u

. 
. // tests
. 
. // the same as the Sanderson-Windmeijer F-statistics reported by ivreg2
. ivreg2 y w1 w2 (x1 x2 = z1 z2), first

