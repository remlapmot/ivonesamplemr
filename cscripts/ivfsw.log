x2                   1.20       1      3995    0.2738

. assert "`e(cmd)'" == "ivregress"

. assert mreldif(e(b), b) == 0

. 
. // weights and robust and cluster-robust variances: the same as ivreg2 after
. // both ivreg2 and ivregress
. gen z3 = rnormal()

. gen wt = 1 + (runiform() > .5) * 3

. gen cl = ceil(_n / 40)

. replace x1 = x1 + rnormal() * abs(z1)
(4,000 real changes made)

. local specs `"", first" ", robust first" ", cluster(cl) first" " [aw=wt], fir
> st" " [fw=wt], first" " [pw=wt], first" " [aw=wt], cluster(cl) first""'

. foreach spec of local specs {
  2.     di _n as txt "ivreg2`spec'"
  3.     ivreg2 y w1 w2 (x1 x2 = z1 z2 z3) `spec'
  4.     mat first = e(first)
  5.     ivfsw
  6.     mat table = r(table)
  7.     assert reldif(table[1, 1], first[rownumb(first, "SWF"), 1]) < 1e-6
  8.     assert reldif(table[2, 1], first[rownumb(first, "SWF"), 2]) < 1e-6
  9.     assert table[1, 3] == first[rownumb(first, "SWFdf2"), 1]
 10.     local ivregspec = subinstr("`spec'", " first", "", 1)
 11.     local ivregspec = subinstr("`ivregspec'", "robust", "vce(robust)", 1)
 12.     local ivregspec = subinstr("`ivregspec'", "cluster(cl)", "vce(cluster 
> cl)", 1)
 13.     ivregress 2sls y w1 w2 (x1 x2 = z1 z2 z3) `ivregspec'
 14.     ivfsw
 15.     assert mreldif(r(table), table) < 1e-6
 16. }

